{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "t-notes",
  "version": "0.1.8",
  "identifier": "com.mariobgsp.tnotes",
  "build": {
    "frontendDist": "../web",
    "devUrl": "http://localhost:8000",
    "beforeDevCommand": "python3 -m http.server 8000 --directory web",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [{ "title": "t-notes", "width": 1100, "height": 750 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": { "webviewInstallMode": { "type": "downloadBootstrapper" } }
  }
}
